{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Adds a compass to maps.",
  "authors": [
    "Qendolin"
  ],
  "contact": {
    "homepage": "https://github.com/Qendolin/map-compass",
    "sources": "https://github.com/Qendolin/map-compass",
    "issues": "https://github.com/Qendolin/map-compass/issues/new"
  },
  "license": "MPL-2.0",
  "icon": "assets/mapcompass/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.qendolin.mapcompass.platforms.fabric.MapCompassFabric"
    ],
    "modmenu": [
      "com.qendolin.mapcompass.platforms.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "mapcompass.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15",
    "minecraft": "${minecraft}",
    "fabric": "*",
    "yet_another_config_lib_v3": "^3.6.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}